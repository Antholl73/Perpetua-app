{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perpetua",
  "mainBinaryName": "perpetua",
  "version": "0.1.0",
  "identifier": "com.perpetua.broadcast",
  "build": {
    "beforeDevCommand": "npm --prefix ../../ui run dev",
    "beforeBuildCommand": "npm --prefix ../../ui run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Perpetua — Broadcast Automation",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "category": "Music",
    "shortDescription": "Perpetua — Broadcast Automation Console",
    "longDescription": "Perpetua es una consola de automatización radial multitarjeta (Aire / Cue), Cart Machine de Jingles, Planificador de Eventos No Destructivos, Carpetas Aleatorias Anti-Repeat y Sincronización Exacta de Pisadores (Sweepers).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libasound2t64 | libasound2", "libwebkit2gtk-4.1-0"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
